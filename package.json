{
  "name": "@positive-intentions/dim",
  "version": "0.0.1",
  "description": "A React-inspired functional web components framework built on native Web Components",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "storybook dev -p 6006",
    "start:webpack": "webpack serve --config webpack.config.cjs",
    "lint": "npm run lint:prettier && npm run lint:eslint",
    "lint:check": "npm run lint:prettier:check && npm run lint:eslint:check",
    "lint:prettier": "prettier --write ./src/**/*.{js,jsx,ts,tsx}",
    "lint:prettier:check": "prettier --check ./src/core/**/*.{js,jsx,ts,tsx}",
    "lint:eslint": "eslint --fix ./src/**/*.{js,jsx,ts,tsx}",
    "lint:eslint:check": "eslint ./src/core/**/*.{js,jsx,ts,tsx}",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "build": "npm run build:reset && npm run build:frontend && npm run build:frontend:vite && npm run build:storybook",
    "build:lib": "tsup && tsc --emitDeclarationOnly --declaration --declarationMap --noCheck -p tsconfig.json",
    "build:reset": "rm -rf ./Frontend && mkdir ./Frontend",
    "build:storybook": "storybook build && cp -r storybook-static/* ./Frontend",
    "build:frontend": "webpack --mode development --config webpack.config.cjs && cp -r dist/* ./Frontend",
    "build:frontend:vite": "vite build && cp -r dist/* ./Frontend",
    "build:development": "webpack --mode development --config webpack.config.cjs && cp -r dist/* ./Frontend",
    "build:coverage": "jest --coverage && cp -r coverage/lcov-report ./Frontend/coverage-report",
    "prepublishOnly": "npm run build:lib",
    "serve:storybook": "serve storybook-static",
    "serve": "serve Frontend --cors -p 8080",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "web-components",
    "framework",
    "hooks",
    "custom-elements",
    "shadow-dom",
    "dim"
  ],
  "author": "positive-intentions",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/positive-intentions/dim.git"
  },
  "homepage": "https://dim.positive-intentions.com",
  "bugs": {
    "url": "https://github.com/positive-intentions/dim/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.27.1",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@emotion/styled": "^11.11.0",
    "@fontsource/material-icons": "^5.0.11",
    "@fontsource/roboto": "^5.0.8",
    "@mui/material": "^5.15.6",
    "@originjs/vite-plugin-federation": "^1.3.5",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-webpack5": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "chance": "^1.1.11",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-storybook": "^0.11.0",
    "fake-indexeddb": "^6.0.1",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-sha3": "^0.9.3",
    "prettier": "3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "serve": "^14.2.1",
    "storybook": "^8.6.14",
    "storybook-dark-mode": "^4.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^5.2.11",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-pwa-manifest": "^4.3.0"
  }
}
